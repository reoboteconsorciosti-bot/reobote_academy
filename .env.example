# Copie para .env.local e preencha. .env e .env.local não vão para o git.
# Nunca compartilhe estes valores por chat ou e-mail aberto.

# Endereço PÚBLICO desta Academy, sem barra no final. OBRIGATÓRIO em produção (Docker/Easypanel):
# sem ele os redirecionamentos apontam para o endereço interno do container (ex.: https://0.0.0.0:3000).
# Em dev pode ficar vazio (usa localhost). Produção: https://<domínio-da-academy>
ACADEMY_URL=

# URL base do CRM, sem barra no final.
# Dev: http://localhost:3000 (por isso a Academy roda na 3001). Produção: domínio do CRM (HTTPS).
CRM_URL=http://localhost:3000

# Credenciais do cliente "Academy" cadastradas no CRM (usadas só no backend, na troca do code).
ACADEMY_CLIENT_ID=reobote-academy
ACADEMY_CLIENT_SECRET=

# Chave para cifrar o cookie de sessão da Academy (AES-256-GCM). Mínimo 32 caracteres. Só a Academy conhece.
# Gerar: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ACADEMY_SESSION_SECRET=
